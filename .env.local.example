# =====================================================
# SARA STORE — Variáveis de Ambiente
# =====================================================
# INSTRUÇÃO: Copie este arquivo para ".env.local"
# e preencha com seus valores reais.
# O .env.local está no .gitignore — NUNCA vai pro GitHub.
# =====================================================

# Supabase — acesse: https://app.supabase.com → seu projeto → Settings → API
VITE_SUPABASE_URL=https://SEU_PROJETO_ID.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Google Gemini AI — acesse: https://aistudio.google.com/app/apikey
VITE_API_KEY=sua_gemini_key_aqui
